APP_NAME=512
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL sobe via `docker compose up -d` (ver docker-compose.yml)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=riftdex
DB_USERNAME=riftdex
DB_PASSWORD=riftdex

# gerar com: php -r 'echo bin2hex(random_bytes(32));'
GAME_SPECIMEN_SECRET=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Em dev os emails vão pro storage/logs/laravel.log. Pra mandar de verdade
# pelo Gmail: MAIL_MAILER=smtp, MAIL_USERNAME = o endereço Gmail e
# MAIL_PASSWORD = a "senha de app" de 16 letras (Conta Google → Segurança →
# Verificação em duas etapas → Senhas de app). Nunca a senha normal da conta.
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="seu-endereco@gmail.com"
MAIL_FROM_NAME="512"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Dev acessível na rede local: IP do PC na rede (ex: 192.168.1.26) e APP_URL com ele.
# SERVER_HOST=0.0.0.0
# DEV_LAN_HOST=

# Reverb (notificações em tempo real): o `php artisan dev` já sobe o servidor
# na porta 8080. No local o host é o DEV_LAN_HOST pro celular conectar pelo IP.
REVERB_APP_ID=512app
REVERB_APP_KEY=512app-key
REVERB_APP_SECRET=512app-secret
REVERB_HOST="${DEV_LAN_HOST}"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
